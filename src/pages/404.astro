---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found - Echo4Ever" description="Sorry, we couldn't find that page." lang="en">
  <section class="section">
    <div class="container text-center" style="max-width: 640px;">
      <h1 style="font-weight: 700;">We couldn't find that page</h1>
      <p class="text-secondary" style="margin: 0 auto 32px;">
        The link may be old, or the page may have moved. Here are some good places to continue:
      </p>
      <p style="display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-bottom: 32px;">
        <a href="/" class="btn btn--primary">Home</a>
        <a href="/features/" class="btn btn--outline">Features</a>
        <a href="/pricing/" class="btn btn--outline">Pricing</a>
        <a href="/privacy/" class="btn btn--outline">Privacy</a>
        <a href="/blog/" class="btn btn--outline">Blog</a>
      </p>
      <p class="text-secondary">
        Need help? Email us at <a href="mailto:contact@echo4ever.com">contact@echo4ever.com</a>.
      </p>
    </div>
  </section>
</Base>

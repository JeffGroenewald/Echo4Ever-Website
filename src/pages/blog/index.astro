---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<Base title="Blog - Echo4Ever" description="Tips, guides and insights on preserving your family's digital memories, legacy planning, and making the most of your Echo4Ever vault." lang="en">
  <section class="blog-listing">
    <div class="container">
      <header class="blog-listing__header">
        <h1>Blog</h1>
        <p>Guides, tips and stories about preserving what matters most.</p>
      </header>

      <div class="blog-listing__grid">
        {posts.map((post) => (
          <a href={`/blog/${post.id.replace(/\.md$/, '')}`} class="blog-card">
            {post.data.image && (
              <img src={post.data.image} alt={post.data.imageAlt || post.data.title} class="blog-card__image" />
            )}
            <div class="blog-card__body">
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
              {post.data.tags.length > 0 && (
                <div class="blog-card__tags">
                  {post.data.tags.map(tag => <span class="blog-card__tag">{tag}</span>)}
                </div>
              )}
            </div>
          </a>
        ))}
      </div>

      {posts.length === 0 && (
        <p class="blog-listing__empty">No posts yet. Check back soon!</p>
      )}
    </div>
  </section>
</Base>

<style>
  .blog-listing {
    padding: 4rem 0;
  }

  .blog-listing__header {
    margin-bottom: 3rem;
  }

  .blog-listing__header h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .blog-listing__header p {
    opacity: 0.7;
    font-size: 1.1rem;
  }

  .blog-listing__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
  }

  .blog-card {
    border-radius: 8px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    border: 1px solid rgba(128, 128, 128, 0.2);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .blog-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
  }

  .blog-card__image {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }

  .blog-card__body {
    padding: 1.5rem;
  }

  .blog-card__body time {
    font-size: 0.85rem;
    opacity: 0.6;
  }

  .blog-card__body h2 {
    font-size: 1.3rem;
    margin: 0.5rem 0;
    line-height: 1.3;
  }

  .blog-card__body p {
    font-size: 0.95rem;
    opacity: 0.8;
    line-height: 1.5;
  }

  .blog-card__tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-top: 0.75rem;
  }

  .blog-card__tag {
    background: var(--color-primary, #2ab5b2);
    color: #fff;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
  }

  .blog-listing__empty {
    text-align: center;
    opacity: 0.6;
    font-size: 1.1rem;
    padding: 3rem 0;
  }
</style>
